# NimbusVault backend — copy to `.env` and adjust. Never commit real secrets.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:5173

# PostgreSQL 16 with the pgvector extension (docker image pgvector/pgvector:pg16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nimbusvault?schema=public

# JWT — in production each must be >= 32 random characters and different (startup refuses otherwise)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# S3-compatible storage (LocalStack for development)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=nimbusvault
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true

# Rate limits (per IP, 15-minute window)
# RATE_LIMIT_MAX=1000
# AUTH_RATE_LIMIT_MAX=30

# ---------------------------------------------------------------------------
# Phase 4 — AI document intelligence (optional).
# With both providers set to `none` the app runs normally and AI endpoints
# report "not configured" (HTTP 503 AI_PROVIDER_UNAVAILABLE).
# ---------------------------------------------------------------------------

# Embeddings (indexing + semantic search): none | local | openai
#   local  = sentence-transformers all-MiniLM-L6-v2 (384 dims) on the server CPU via
#            @huggingface/transformers. Document text never leaves the server.
#            The ~23 MB model downloads once into AI_LOCAL_MODEL_CACHE_DIR.
#   openai = any OpenAI-compatible /embeddings endpoint (OpenAI, Ollama, vLLM, ...)
AI_EMBEDDING_PROVIDER=none
# AI_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2        # openai default: text-embedding-3-small
# AI_EMBEDDING_DIMENSIONS=384                        # openai default: 1536
# AI_EMBEDDING_BASE_URL=https://api.openai.com/v1    # e.g. http://localhost:11434/v1 for Ollama
# AI_EMBEDDING_API_KEY=
# AI_LOCAL_MODEL_CACHE_DIR=.cache/models
# AI_SEARCH_MIN_SCORE=0.25

# Generation (summaries + grounded Q&A): none | openai | anthropic
#   openai    = OpenAI-compatible /chat/completions (default model gpt-4o-mini)
#   anthropic = Anthropic Messages API (default model claude-haiku-5-5)
# PRIVACY: with a hosted provider, relevant document passages are sent to that
# provider. The UI shows a disclosure whenever this is the case.
AI_GENERATION_PROVIDER=none
# AI_GENERATION_MODEL=
# AI_GENERATION_BASE_URL=
# AI_GENERATION_API_KEY=
# AI_MAX_OUTPUT_TOKENS=700
# AI_AUTO_SUMMARY=true

# Limits and worker
# AI_MAX_FILE_BYTES=26214400
# AI_MAX_PDF_PAGES=500
# AI_MAX_EXTRACTED_CHARS=1000000
# AI_CHUNK_CHARS=1200
# AI_CHUNK_OVERLAP=200
# AI_MAX_CONTEXT_CHARS=12000
# AI_PROVIDER_TIMEOUT_MS=60000
# AI_MAX_CONCURRENT_GENERATIONS=2
# AI_QUERY_RATE_LIMIT=30            # per user per AI_QUERY_RATE_WINDOW_MS
# AI_QUERY_RATE_WINDOW_MS=600000
# AI_WORKER_ENABLED=true
# AI_WORKER_CONCURRENCY=1
# AI_WORKER_POLL_MS=3000
# AI_JOB_MAX_ATTEMPTS=3
