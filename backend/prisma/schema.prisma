generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  FILE
  FOLDER
  SHARE_LINK
  USER
}

enum SharePermission {
  VIEW
  DOWNLOAD
}

enum PermissionLevel {
  VIEWER
  EDITOR
}

enum FileCategory {
  pdf
  image
  video
  document
  other
}

enum FileStatus {
  UPLOADING
  READY
  FAILED
}

enum AiStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
  NA
}

enum ActivityAction {
  auth_login
  auth_failed_login
  auth_logout
  auth_password_change
  file_upload
  file_download
  file_delete
  file_restore
  file_rename
  file_move
  folder_create
  folder_delete
  share_create
  share_revoke
  share_access
  ai_query
}

model User {
  id                String           @id @default(uuid())
  name              String
  email             String           @unique @db.Citext
  passwordHash      String
  role              String           @default("user")
  status            String           @default("active")
  storageQuotaBytes BigInt           @default(5368709120)
  storageUsedBytes  BigInt           @default(0)
  lastLoginAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  refreshTokens     RefreshToken[]
  sessions          UserSession[]
  activityLogs      ActivityLog[]

  @@index([email])
  @@map("users")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  device       String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  revokedAt    DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastUsedAt])
  @@map("user_sessions")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String
  tokenFamily String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Folder {
  id                String   @id @default(uuid())
  name              String
  ownerId           String
  parentFolderId    String?
  depth             Int      @default(0)
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent            Folder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  children          Folder[] @relation("FolderHierarchy")
  files             File[]
  permissions       Permission[]

  @@unique([ownerId, parentFolderId, name])
  @@index([ownerId, parentFolderId])
  @@index([parentFolderId])
  @@map("folders")
}

model File {
  id              String   @id @default(uuid())
  filename        String
  sizeBytes       BigInt
  mimeType        String
  category        FileCategory
  ownerId         String
  folderId        String?
  s3Key           String   @unique
  checksumSha256  String?
  status          FileStatus @default(UPLOADING)
  aiStatus        AiStatus   @default(NA)
  uploadedAt      DateTime @default(now())
  deletedAt       DateTime?
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder          Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shareLinks      ShareLink[]
  permissions     Permission[]
  activityLogs    ActivityLog[]

  @@index([ownerId, deletedAt, uploadedAt])
  @@index([ownerId, folderId, deletedAt])
  @@index([ownerId, category])
  @@map("files")
}

model ShareLink {
  id             String         @id @default(uuid())
  fileId         String
  createdBy      String
  token          String         @unique
  permission     SharePermission
  passwordHash   String?
  expiresAt      DateTime?
  maxDownloads   Int?
  downloadCount  Int            @default(0)
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  file           File           @relation(fields: [fileId], references: [id], onDelete: Cascade)
  creator        User           @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([token])
  @@map("share_links")
}

model Permission {
  id               String           @id @default(uuid())
  resourceType     ResourceType
  resourceId       String
  granteeUserId    String
  level            PermissionLevel
  grantedBy        String
  createdAt        DateTime         @default(now())
  user             User             @relation(fields: [granteeUserId], references: [id], onDelete: Cascade)

  @@unique([resourceType, resourceId, granteeUserId])
  @@index([resourceType, resourceId])
  @@index([granteeUserId])
  @@map("permissions")
}

model ActivityLog {
  id            BigInt         @id @default(autoincrement())
  userId        String?
  action        ActivityAction
  resourceType  ResourceType?
  resourceId    String?
  ipAddress     String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@map("activity_logs")
}
