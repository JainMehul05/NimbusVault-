{
  "name": "nimbusvault",
  "version": "1.0.0",
  "description": "NimbusVault - AI-powered cloud storage platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "e2e",
    "infra"
  ],
  "scripts": {
    "dev": "node scripts/platform.cjs start",
    "start": "node scripts/platform.cjs start",
    "stop": "node scripts/platform.cjs stop",
    "setup": "node scripts/platform.cjs setup",
    "warmup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/warmup.ps1",
    "backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm test --workspace=backend",
    "test:frontend": "npm run test:run --workspace=frontend",
    "lint": "npm run lint --workspace=backend --workspace=frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "lint:frontend": "npm run lint --workspace=frontend",
    "db:generate": "npm run prisma:generate --workspace=backend",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:studio": "npm run prisma:studio --workspace=backend",
    "db:push": "npm run prisma:push --workspace=backend",
    "docker:build": "docker compose build",
    "docker:up": "docker compose --env-file .env -f compose.local.yml up -d --wait",
    "docker:down": "docker compose --env-file .env -f compose.local.yml stop",
    "docker:logs": "docker compose --env-file .env -f compose.local.yml logs -f",
    "test:e2e": "npm run e2e --workspace=e2e",
    "aws:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aws-start.ps1",
    "aws:connect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aws-connect.ps1",
    "aws:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aws-status.ps1",
    "aws:warmup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aws-warmup.ps1",
    "aws:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aws-stop.ps1",
    "aws:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aws-backup.ps1",
    "aws:url": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aws-url.ps1",
    "aws:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aws-doctor.ps1",
    "ai:set-groq-key": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-groq-key.ps1",
    "ai:provider": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/set-ai-provider.ps1"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
