# Generate actual local secrets once with scripts/configure-local.py; never commit .env.
DATABASE_URL=postgresql://nimbusvault:GENERATED_LOCAL_PASSWORD@127.0.0.1:55432/nimbusvault?schema=public
NIMBUS_DB_PASSWORD=GENERATED_LOCAL_PASSWORD
JWT_ACCESS_SECRET=GENERATE_64_RANDOM_HEX_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_64_RANDOM_HEX_CHARACTERS
INTERNAL_SERVICE_TOKEN=GENERATE_DIFFERENT_64_RANDOM_HEX_CHARACTERS
PORT=3100
FRONTEND_URL=http://127.0.0.1:3100
COOKIE_SECURE=false
SERVE_FRONTEND=true
INTELLIGENCE_ENABLED=true
AI_EMBEDDING_PROVIDER=none
AI_GENERATION_PROVIDER=none
AI_WORKER_ENABLED=true
AI_WORKER_CONCURRENCY=1
MAINTENANCE_ENABLED=false
TRASH_RETENTION_DAYS=0
MAX_FILE_BYTES=26214400
AWS_PROFILE=default
AWS_REGION=ap-southeast-2
S3_BUCKET=EXISTING_PRIVATE_CLOUDVAULT_BUCKET
S3_OBJECT_PREFIX=cloudvault/files/
AWS_OPERATIONS_ENABLED=false
AWS_WRITES_ENABLED=false
NIMBUS_LOCAL_RETRIEVAL=true
# Optional existing shared local cache; weights stay outside Git.
EMBEDDING_CACHE_DIR=C:/path/to/existing/minilm/cache
# Credentials must remain in the AWS supported temporary provider, never here.
