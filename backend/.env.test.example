# Copy to `.env.test` (loaded by tests/setup.ts) to run the integration suites locally.
# Requires PostgreSQL+pgvector on 5433 (docker compose up postgres localstack) with
# migrations applied (`npx prisma migrate deploy`), and the LocalStack bucket.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=nimbusvault
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true
# AI tests install deterministic test doubles; no provider or key is needed.
AI_EMBEDDING_PROVIDER=none
AI_GENERATION_PROVIDER=none
