{
  "name": "nimbusvault-backend",
  "version": "1.0.0",
  "description": "NimbusVault Backend API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prisma:deploy": "prisma migrate deploy",
    "test": "node scripts/test-env.cjs jest --runInBand",
    "test:watch": "node scripts/test-env.cjs jest --watch",
    "test:cov": "node scripts/test-env.cjs jest --runInBand --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "test:prepare": "node scripts/test-env.cjs prisma migrate deploy",
    "start:worker": "node dist/worker.js",
    "migrate": "node scripts/migrate.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-storage": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@prisma/client": "^5.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.11.24",
    "@types/node-fetch": "^2.6.13",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "node-fetch": "^2.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "@napi-rs/canvas": "^0.1.80"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "tesseract.js": "^7.0.0"
  }
}
