# NimbusVault backend: copy to `.env` and adjust. Never commit real secrets.
# Full reference: docs/guides/environment.md

NODE_ENV=development
PORT=3000
API_PREFIX=v1
FRONTEND_URL=http://localhost:5173
# Proxies in front of the API (Docker Compose 1, AWS 2)
# TRUST_PROXY=1

# PostgreSQL 16 with the pgvector extension (docker image pgvector/pgvector:pg16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/nimbusvault?schema=public

# In production each must be 32+ random characters and different (startup refuses otherwise)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# S3-compatible storage (LocalStack for development). On AWS set only the region and bucket.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=nimbusvault
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true

# Optional AI. With both providers `none` the app runs normally and AI reports "not configured".
#   local  = all-MiniLM-L6-v2 on this machine; document text never leaves it (about 90 MB, downloaded once)
AI_EMBEDDING_PROVIDER=none
# AI_LOCAL_MODEL_CACHE_DIR=.cache/models
# Summaries and answers: none | openai | anthropic.
# PRIVACY: a hosted provider receives the relevant document passages; the app tells users so.
AI_GENERATION_PROVIDER=none
# AI_GENERATION_MODEL=
# AI_GENERATION_API_KEY=
# Local OCR of scanned PDFs (slow)
# AI_OCR_ENABLED=true
